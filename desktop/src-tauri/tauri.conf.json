{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DRAGON",
  "version": "0.1.0",
  "identifier": "com.dragon.music",
  "build": {
    "frontendDist": "../../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DRAGON",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "resources/omniget.exe",
      "resources/yt-dlp.exe",
      "resources/ffmpeg.exe",
      "resources/THIRD_PARTY_NOTICES.txt"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
