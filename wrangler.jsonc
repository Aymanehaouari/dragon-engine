{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dragon-music",
  "main": "index.js",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHANNEL_REGISTRY",
        "class_name": "ChannelRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DragonDownloader"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["DragonDownloader"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["ChannelRegistry"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
