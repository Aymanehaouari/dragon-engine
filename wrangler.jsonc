{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dragon-music",
  "main": "index.js",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DragonDownloader"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["DragonDownloader"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
